vardef_begin_index(`MQTT',,8,MAX_LOGICAL_SERIAL_LINES)
    vardef_index_information(`true',`LineName')
    vardef_enum(50009,`Protocol',`TCP=1/TLS/Websocket',1)
    vardef_text(50001,`Broker Address',50)
    vardef_uint16(50002,`Broker Port',0,,`<None>')
    vardef_begin_index(`-url',`CONFIG_VALUE_OF_IS_(`MQTT\Protocol',`Websocket') || CONFIG_VALUE_OF_IS_(`MQTT\Protocol',`Websocket Secure')')
        vardef_text(50010,`URL',256)
    vardef_end_index(`-url')
    vardef_begin_index(`-cred',`CONFIG_VALUE_OF_IS_(`MQTT\Protocol',`TLS') || CONFIG_VALUE_OF_IS_(`MQTT\Protocol',`Websocket Secure')')
        vardef_text(50003,`Credential Name',256)
    vardef_end_index(`-cred')
    vardef_uint16(50004,`Local Port',0,,`<Random>')
    vardef_text(50005,`Device ID',128)
    vardef_text(50006,`User Name',256)
    vardef_text(50007,`Auth Token',256)
    vardef_text(50008,`Publish Topic',128)
    vardef_begin_index(`Subscribe',,8,MAX_MQTT_SUBSCRIBE_TOPICS)
        vardef_index_information(`false')
        vardef_summary(`MQTTSubscribeSummary')
            vardef_text(50011,`Topic',128)
    vardef_end_index(`Subscribe')
    vardef_enum(50000,`Diagnostic Log',`Disabled/Partial/Full=4',0)
vardef_end_index(`MQTT',`LineToMqttTestSet',`LineToMqttWarnings')

statusdef_begin_index(`MQTT',,8,MAX_LOGICAL_SERIAL_LINES)
    statusdef_index_information(`true',`LineName')
    statusdef_enum(`State',`Down/Connecting/Up')
    statusdef_begin_index(`-IsUp',`STATUS_VALUE_OF_IS_(`MQTT\State',`Up')')
        statusdef_counter(`Uptime',`seconds')
    statusdef_end_index(`-IsUp')
    statusdef_counter(`Connections')
    statusdef_counter(`Connect Fail')
    statusdef_counter(`Publish Out')
    statusdef_counter(`Publish Fail')
    statusdef_counter(`Subscribe In')
    statusdef_counter(`Subscribe Discard')
statusdef_end_index(`MQTT',`LineToMqttGetStatus')
