define PROJECT_IMAGE_HASH_template

$(WORK_DIRECTORY)/$(PROJECT_NAME)/$(1).sha256: \
  $(WORK_DIRECTORY)/$(PROJECT_NAME)/$(1).rom
	@echo $$(notdir $$@)
	$(veryquiet)sha256sum $$< > $$@
endef

